---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  buildSrcset,
  getDisplayName,
  getImageSets,
  getProductDescription,
  pickRelatedProducts,
  toCardProduct,
  toParagraphs,
  type CardProduct,
  type Product,
} from "../../lib/products";
import productsData from "../../data/products.json";
import StockUrgency from "../../components/StockUrgency.astro";
import DiscoveryGuide from "../../components/DiscoveryGuide.astro";
import FaceGuide from "../../components/FaceGuide.astro";
import WhatsAppJourney from "../../components/WhatsAppJourney.astro";
import MidPageCTA from "../../components/MidPageCTA.astro";
import SocialProof from "../../components/SocialProof.astro";
import UnboxingSection from "../../components/UnboxingSection.astro";

const allProducts = productsData as Product[];

export function getStaticPaths() {
  const products = productsData as Product[];
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

type VariantWithColor = Product["variants"][number] & {
  color?: string;
  hex?: string;
  value?: string;
};

type DisplayVariant = Product["variants"][number] & {
  colorValue: string | null;
  message: string;
};

const { product } = Astro.props as { product: Product };
const imageSets = getImageSets(product.images);
const firstImage = imageSets[0];
const relatedProducts = pickRelatedProducts(allProducts, product.slug, 4).map(toCardProduct);
const displayName = getDisplayName(product.name);
const productDescription = getProductDescription(product);
const currentStock = product.stock ?? 0;
const isPurchasable = product.available === true && currentStock > 0;
const isLowStock = isPurchasable && currentStock <= 3;
const ctaLabel = isPurchasable ? "Comprar pelo WhatsApp" : "Consultar reposi\u00e7\u00e3o";
const availabilityText = !isPurchasable
  ? "Indispon\u00edvel no momento"
  : isLowStock
    ? "Poucas unidades dispon\u00edveis"
    : "Dispon\u00edvel para compra assistida";
const formattedPrice = new Intl.NumberFormat("pt-BR", {
  style: "currency",
  currency: "BRL",
  minimumFractionDigits: 2,
  maximumFractionDigits: 2,
}).format(product.price);
const availableWhatsappMessage = `Ol\u00e1! Tenho interesse no ${product.name}. Podem me ajudar com disponibilidade e frete?`;
const unavailableWhatsappMessage = `Ol\u00e1! Tenho interesse no ${product.name}. Podem me avisar quando voltar ou indicar modelos parecidos?`;
const whatsappMessage = isPurchasable ? availableWhatsappMessage : unavailableWhatsappMessage;
const whatsappUrl = `https://wa.me/5571993135522?text=${encodeURIComponent(whatsappMessage)}`;
const detailsEntries = Object.entries(product.description.details ?? {});
const selectedVariantIndex =
  product.variants.findIndex((variant) => variant.stock > 0) >= 0
    ? product.variants.findIndex((variant) => variant.stock > 0)
    : 0;
const displayVariants: DisplayVariant[] = product.variants.map((variant) => ({
  ...variant,
  colorValue: getVariantColor(variant as VariantWithColor),
  message: buildVariantWhatsappMessage(product.name, variant.name, isPurchasable),
}));
const hasIncludedCopy = hasCaseAndFlanela(product);
const includedCopy = hasIncludedCopy ? "Acompanha case e flanela." : "Informa\u00e7\u00e3o incompleta no cat\u00e1logo atual.";
const incompleteCopy = "Informa\u00e7\u00e3o incompleta no cat\u00e1logo atual.";
const productUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();
const productJsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: product.name,
  description: productDescription,
  image: imageSets.map((imageSet) => new URL(`/${imageSet.src}`, Astro.site ?? Astro.url.origin).toString()),
  offers: {
    "@type": "Offer",
    price: product.price,
    priceCurrency: "BRL",
    availability: isPurchasable ? "https://schema.org/InStock" : "https://schema.org/OutOfStock",
    url: productUrl,
  },
};

function sectionLines(value: string | null): string[] {
  if (!value) {
    return [];
  }

  return toParagraphs(value).filter((line) => {
    const normalized = line.toLowerCase();
    return normalized !== "rivano experience" && normalized !== "como fica" && normalized !== "detalhes";
  });
}

function normalizeText(value: string): string {
  return value
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase();
}

function getVariantColor(variant: VariantWithColor): string | null {
  const explicitColor = variant.color ?? variant.hex ?? variant.value;

  if (explicitColor) {
    return explicitColor;
  }

  const name = normalizeText(variant.name);

  if (name.includes("clara") || name.includes("transparente")) {
    return "var(--rivano-beige)";
  }

  if (name.includes("escura") || name.includes("preta") || name.includes("grafite")) {
    return "var(--rivano-brown)";
  }

  if (name.includes("marrom") || name.includes("tartaruga")) {
    return "var(--rivano-brown-mid)";
  }

  if (name.includes("dourad")) {
    return "var(--rivano-gold)";
  }

  return null;
}

function buildVariantWhatsappMessage(productName: string, variantName: string, available: boolean): string {
  if (available) {
    return `Ol\u00e1! Tenho interesse no ${productName} - ${variantName}. Podem me ajudar com disponibilidade e frete?`;
  }

  return `Ol\u00e1! Tenho interesse no ${productName} - ${variantName}. Podem me avisar quando voltar ou indicar modelos parecidos?`;
}

function hasCaseAndFlanela(product: Product): boolean {
  const values = [
    product.description.body,
    product.description.experience,
    product.description.fit,
    ...Object.entries(product.description.details ?? {}).flat(),
  ]
    .filter(Boolean)
    .join(" ");
  const normalized = normalizeText(values);

  return normalized.includes("case") && normalized.includes("flanela");
}

function relatedImageSrcset(product: CardProduct): string {
  const normalized = product.image.startsWith("/") ? product.image : `/${product.image}`;

  if (!/-(?:600|1200|2000)\.webp$/i.test(normalized)) {
    return "";
  }

  return [600, 1200, 2000]
    .map((width) => `${normalized.replace(/-(?:600|1200|2000)\.webp$/i, `-${width}.webp`)} ${width}w`)
    .join(", ");
}

function formattedRelatedPrice(value: number): string {
  return new Intl.NumberFormat("pt-BR", {
    style: "currency",
    currency: "BRL",
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  }).format(value);
}
---

<BaseLayout title={`${product.name} | Rivano`} description={productDescription} showBottomBar={false}>
  <script type="application/ld+json" set:html={JSON.stringify(productJsonLd)} />
  <article class="pdp-page">
    <section class="pdp-main" aria-label={`Detalhes de ${displayName}`}>
      <div class="pdp-gallery">
        {imageSets.length > 0 ? (
          <>
            <div class="pdp-media" data-carousel aria-label={`Fotos de ${displayName}`}>
              {imageSets.map((imageSet, index) => (
                <figure class="pdp-media-slide" data-slide={index}>
                  <img
                    src={`/${imageSet.src}`}
                    srcset={buildSrcset(imageSet)}
                    sizes="(min-width: 1024px) 50vw, 100vw"
                    alt={`${displayName} — foto ${index + 1}`}
                    class="pdp-media-image"
                    loading={index === 0 ? "eager" : "lazy"}
                    fetchpriority={index === 0 ? "high" : undefined}
                    decoding="async"
                    width="1024"
                    height="1365"
                  />
                </figure>
              ))}
            </div>

            {imageSets.length > 1 && (
              <div class="pdp-media-pagination" data-dots aria-hidden="true">
                {imageSets.map((_, index) => (
                  <span class:list={["pdp-media-tick", index === 0 && "is-active"]} data-dot-indicator></span>
                ))}
              </div>
            )}
          </>
        ) : (
          <div class="gallery-empty">Imagem indispon&iacute;vel</div>
        )}
      </div>

      <aside class="product-panel">
        <div class="pdp-identity">
          <h1 class="pdp-name">{displayName}</h1>
          <p class="pdp-price">{formattedPrice}</p>
        </div>

        {displayVariants.length > 0 && (
          <div class="pdp-variants" aria-label="Varia&ccedil;&otilde;es dispon&iacute;veis">
            {displayVariants.map((variant, index) => (
              <button
                type="button"
                class:list={[
                  "pdp-variant",
                  index === selectedVariantIndex && variant.stock > 0 && "is-active",
                  variant.stock <= 0 && "is-disabled",
                ]}
                aria-pressed={index === selectedVariantIndex && variant.stock > 0 ? "true" : "false"}
                data-variant-option
                data-whatsapp-message={variant.message}
                disabled={variant.stock <= 0}
              >
                {variant.name}
              </button>
            ))}
          </div>
        )}




        <StockUrgency stock={currentStock} />

        <div class="technical-accordion">
          <details open={detailsEntries.length > 0} class="accordion-item">
            <summary>
              <span>Detalhes do modelo</span>
              <span class="accordion-symbol" aria-hidden="true">
                <span class="symbol-plus">+</span>
                <span class="symbol-minus">&minus;</span>
              </span>
            </summary>
            <div class="accordion-body">
              {detailsEntries.length > 0 ? (
                <dl class="technical-list">
                  {detailsEntries.map(([key, value]) => (
                    <div>
                      <dt>{key}</dt>
                      <dd>{value}</dd>
                    </div>
                  ))}
                </dl>
              ) : (
                <p>{incompleteCopy}</p>
              )}
            </div>
          </details>


          <details class="accordion-item">
            <summary>
              <span>O que acompanha</span>
              <span class="accordion-symbol" aria-hidden="true">
                <span class="symbol-plus">+</span>
                <span class="symbol-minus">&minus;</span>
              </span>
            </summary>
            <div class="accordion-body">
              <p>{includedCopy}</p>
            </div>
          </details>

          <details class="accordion-item">
            <summary>
              <span>Trocas e garantia</span>
              <span class="accordion-symbol" aria-hidden="true">
                <span class="symbol-plus">+</span>
                <span class="symbol-minus">&minus;</span>
              </span>
            </summary>
            <div class="accordion-body">
              <p>Voc&ecirc; tem at&eacute; 30 dias para trocar. O atendimento acontece pelo WhatsApp.</p>
            </div>
          </details>
        </div>
        <div class="pdp-buy">
          <a
            class:list={["pdp-cta", !isPurchasable && "is-secondary"]}
            href={whatsappUrl}
            data-primary-cta
            data-whatsapp-link
          >
            {isPurchasable ? "Comprar" : "Consultar reposi\u00e7\u00e3o"}
          </a>
        </div>

      </aside>
    </section>


    <DiscoveryGuide />

    <FaceGuide whatsappUrl={whatsappUrl} productName={product.name} />

    <section class="assisted-section" aria-labelledby="assisted-purchase">
      <div class="assisted-inner">
        <header class="assisted-header">
          <p class="assisted-label">Compra assistida</p>
          <h2 id="assisted-purchase" class="display-sm assisted-title">Compra assistida Rivano</h2>
          <p>Voc&ecirc; escolhe o modelo, fala com a gente pelo WhatsApp e finaliza com atendimento humano.</p>
        </header>
        <div class="assisted-grid">
          <article class="assisted-card">
            <span>01</span>
            <h3>Atendimento humano</h3>
            <p>Tiramos d&uacute;vidas antes da compra.</p>
          </article>
          <article class="assisted-card">
            <span>02</span>
            <h3>Envio e disponibilidade</h3>
            <p>Confirmamos frete e estoque no atendimento.</p>
          </article>
          <article class="assisted-card">
            <span>03</span>
            <h3>Troca sem burocracia</h3>
            <p>Voc&ecirc; tem at&eacute; 30 dias para trocar.</p>
          </article>
        </div>
      </div>
    </section>

    <SocialProof />

    <WhatsAppJourney whatsappUrl={whatsappUrl} />

    <MidPageCTA whatsappUrl={whatsappUrl} productName={product.name} />

    <UnboxingSection />

    {relatedProducts.length > 0 && (
      <section class="related-section" aria-labelledby="related-products">
        <h2 id="related-products" class="display-sm related-title">Na mesma curadoria</h2>
        <div class="related-track">
          {relatedProducts.map((related, index) => (
            <a href={`/produtos/${related.slug}`} class="related-card" aria-label={`Ver ${related.name}`}>
              <figure class="related-frame">
                <img
                  src={related.image}
                  srcset={relatedImageSrcset(related)}
                  sizes="(min-width: 768px) 25vw, 64vw"
                  alt={related.name}
                  class="related-image"
                  loading={index < 2 ? "eager" : "lazy"}
                  decoding="async"
                  width="900"
                  height="1200"
                />
              </figure>
              <h3>{related.name}</h3>
              <p>{formattedRelatedPrice(related.price)}</p>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>


  {firstImage && (
    <div class="desktop-sticky-bar" data-sticky-bar hidden>
      <div class="sticky-product">
        <img
          src={`/${firstImage.src}`}
          srcset={buildSrcset(firstImage)}
          sizes="40px"
          alt=""
          class="sticky-product-image"
          loading="lazy"
          decoding="async"
          width="80"
          height="106"
        />
        <div>
          <p class="sticky-product-name">{product.name}</p>
          <p class="sticky-product-price">{formattedPrice}</p>
        </div>
      </div>
      <a class="sticky-whatsapp-link" href={whatsappUrl} data-whatsapp-link>
        <span>{ctaLabel}</span>
      </a>
    </div>
  )}

  <style>
    .pdp-page {
      background: #fff;
      color: var(--rivano-brown);
      overflow-x: clip;
    }

    /* ── Bloco 01 do PDP — arquitetura global, data-driven.
       Decodificada de chimi-online.com/p/04-black-24 em 390x844:
       midia 4:5 logo abaixo do header, nome e preco na mesma linha,
       opcoes compactas, CTA em wrapper sticky no rodape.
       Adaptacoes de fato: o catalogo Rivano so tem ratios 2:3 e 3:4,
       entao o quadro comum e 3:4 — corta menos o packshot 2:3 do que
       o 4:5 da referencia. Nenhuma regra por slug. */
    .pdp-main {
      display: flex;
      flex-direction: column;
      width: 100%;
    }

    .pdp-gallery {
      width: 100%;
    }

    .pdp-media {
      display: flex;
      gap: 0;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }

    .pdp-media::-webkit-scrollbar {
      display: none;
    }

    .pdp-media-slide {
      flex: 0 0 100%;
      margin: 0;
      scroll-snap-align: center;
    }

    /* Quadro comum a todo o catalogo. cover mantem o enquadramento
       previsivel entre produtos; nas fotos 2:3 a perda cai nas faixas
       de fundo, sem tocar o produto. */
    .pdp-media-image {
      aspect-ratio: 3 / 4;
      display: block;
      height: auto;
      object-fit: cover;
      object-position: center;
      width: 100%;
    }

    /* Paginacao: reguas finas, uma por foto real do produto. */
    .pdp-media-pagination {
      display: flex;
      gap: 4px;
      justify-content: center;
      padding: 14px 0 0;
    }

    .pdp-media-tick {
      background: color-mix(in srgb, var(--rivano-brown) 22%, transparent);
      display: block;
      height: 1px;
      transition: background var(--transition-normal);
      width: 22px;
    }

    .pdp-media-tick.is-active {
      background: var(--rivano-brown);
    }

    .pdp-identity {
      align-items: baseline;
      display: flex;
      gap: 16px;
      justify-content: space-between;
      padding-top: 26px;
    }

    .pdp-name {
      color: var(--rivano-brown);
      font-family: var(--font-sans);
      font-size: 15px;
      font-weight: 400;
      letter-spacing: 0.12em;
      line-height: 1.3;
      margin: 0;
      text-transform: uppercase;
    }

    .pdp-price {
      color: var(--rivano-brown);
      font-family: var(--font-sans);
      font-size: 15px;
      font-weight: 400;
      line-height: 1.3;
      margin: 0;
      white-space: nowrap;
    }

    /* So renderiza quando o produto tem variante real. */
    .pdp-variants {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      padding-top: 18px;
    }

    .pdp-variant {
      background: transparent;
      border: 1px solid color-mix(in srgb, var(--rivano-brown) 28%, transparent);
      color: var(--rivano-brown);
      cursor: pointer;
      font-family: var(--font-sans);
      font-size: 11px;
      font-weight: 400;
      letter-spacing: 0.1em;
      min-height: 40px;
      padding: 0 16px;
      text-transform: uppercase;
      transition: border-color var(--transition-normal), color var(--transition-normal);
    }

    .pdp-variant.is-active {
      border-color: var(--rivano-brown);
    }

    .pdp-variant.is-disabled {
      color: color-mix(in srgb, var(--rivano-brown) 38%, transparent);
      cursor: not-allowed;
      text-decoration: line-through;
    }

    /* O CTA acompanha a rolagem, como na referencia: a acao de compra
       nunca sai da tela. O fundo proprio evita que a foto passe atras. */
    .pdp-buy {
      background: #fff;
      bottom: 0;
      padding: 18px 0 calc(14px + env(safe-area-inset-bottom));
      position: sticky;
      z-index: 4;
    }

    .pdp-cta {
      align-items: center;
      background: var(--rivano-brown);
      color: #fff;
      display: flex;
      font-family: var(--font-sans);
      font-size: 12px;
      font-weight: 400;
      justify-content: center;
      letter-spacing: 0.14em;
      line-height: 1.2;
      min-height: 48px;
      text-align: center;
      text-decoration: none;
      text-transform: uppercase;
      transition: opacity var(--transition-normal);
      width: 100%;
    }

    .pdp-cta.is-secondary {
      background: color-mix(in srgb, var(--rivano-brown) 88%, var(--rivano-muted));
    }

    .pdp-cta:hover {
      opacity: 0.86;
    }

    .gallery-empty {
      align-items: center;
      aspect-ratio: 3 / 4;
      background: color-mix(in srgb, var(--rivano-off-white) 82%, var(--rivano-beige));
      color: var(--rivano-muted);
      display: flex;
      font-family: var(--font-sans);
      font-size: 11px;
      justify-content: center;
      letter-spacing: 0.14em;
      min-height: 420px;
      text-transform: uppercase;
      width: 100%;
    }

    .product-panel {
      display: flex;
      flex-direction: column;
      gap: 0;
      padding: 0 24px 40px;
    }

    .panel-label {
      color: var(--rivano-brown);
      font-family: var(--font-sans);
      font-size: 10px;
      font-weight: 400;
      letter-spacing: 0.1em;
      line-height: 1.4;
      margin-bottom: 10px;
      text-transform: uppercase;
    }

    .sticky-whatsapp-link:hover {
      opacity: 0.86;
    }

    .technical-accordion {
      margin-top: 2px;
    }

    .accordion-item {
      border-top: 1px solid color-mix(in srgb, var(--rivano-brown) 13%, transparent);
    }

    .accordion-item:last-child {
      border-bottom: 1px solid color-mix(in srgb, var(--rivano-brown) 13%, transparent);
    }

    .accordion-item summary {
      align-items: center;
      cursor: pointer;
      display: flex;
      font-family: var(--font-sans);
      font-size: 13px;
      font-weight: 400;
      justify-content: space-between;
      letter-spacing: 0.1em;
      line-height: 1.35;
      list-style: none;
      min-height: 52px;
      text-transform: uppercase;
    }

    .accordion-item summary::-webkit-details-marker {
      display: none;
    }

    .accordion-symbol {
      align-items: center;
      display: inline-flex;
      justify-content: center;
      min-height: 44px;
      min-width: 44px;
    }

    .symbol-minus {
      display: none;
    }

    .accordion-item[open] .symbol-plus {
      display: none;
    }

    .accordion-item[open] .symbol-minus {
      display: inline;
    }

    .accordion-body {
      color: color-mix(in srgb, var(--rivano-brown) 70%, transparent);
      font-family: var(--font-sans);
      font-size: 13px;
      line-height: 1.75;
      overflow: visible;
      padding-bottom: 18px;
    }

    .technical-list {
      display: grid;
      gap: 9px;
    }

    .technical-list div {
      display: grid;
      gap: 4px;
      grid-template-columns: minmax(96px, 0.4fr) 1fr;
    }

    .technical-list dt {
      color: var(--rivano-muted);
    }

    .accordion-copy {
      display: grid;
      gap: 8px;
    }

    .assisted-section {
      background: var(--rivano-beige);
      padding: 56px 24px;
    }

    .assisted-inner {
      display: grid;
      gap: 28px;
    }

    .assisted-label {
      color: color-mix(in srgb, var(--rivano-brown) 45%, transparent);
      font-family: var(--font-sans);
      font-size: 10px;
      letter-spacing: 0.16em;
      line-height: 1.35;
      margin-bottom: 12px;
      text-transform: uppercase;
    }

    .assisted-title {
      font-family: var(--font-serif);
      font-weight: 300;
    }

    .assisted-header p {
      color: color-mix(in srgb, var(--rivano-brown) 64%, transparent);
      font-family: var(--font-sans);
      font-size: 14px;
      font-weight: 300;
      line-height: 1.7;
      margin-top: 16px;
      max-width: 520px;
    }

    .assisted-grid {
      display: grid;
      gap: 14px;
    }

    .assisted-card {
      border-top: 1px solid color-mix(in srgb, var(--rivano-brown) 18%, transparent);
      padding: 22px 0 4px;
    }

    .assisted-card span {
      color: color-mix(in srgb, var(--rivano-brown) 42%, transparent);
      display: block;
      font-family: var(--font-sans);
      font-size: 10px;
      letter-spacing: 0.16em;
      line-height: 1.35;
      margin-bottom: 14px;
    }

    .assisted-card h3 {
      color: var(--rivano-brown);
      font-family: var(--font-serif);
      font-size: 24px;
      font-weight: 300;
      line-height: 1.05;
    }

    .assisted-card p {
      color: color-mix(in srgb, var(--rivano-brown) 62%, transparent);
      font-family: var(--font-sans);
      font-size: 13px;
      font-weight: 300;
      line-height: 1.65;
      margin-top: 10px;
    }

    .related-section {
      background: var(--rivano-off-white);
      padding: 56px 0 72px;
    }

    .related-title {
      color: var(--rivano-brown);
      font-family: var(--font-serif);
      font-weight: 300;
      margin-bottom: 24px;
      padding: 0 24px;
    }

    .related-track {
      display: flex;
      gap: 12px;
      overflow-x: auto;
      padding: 0 24px;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .related-card {
      flex: 0 0 64vw;
      min-height: 44px;
      min-width: 0;
      scroll-snap-align: start;
    }

    .related-frame {
      aspect-ratio: 3 / 4;
      background: color-mix(in srgb, var(--rivano-off-white) 82%, var(--rivano-beige));
      overflow: hidden;
    }

    .related-image {
      padding: 24px;
    }

    .related-card h3 {
      color: var(--rivano-brown);
      font-family: var(--font-serif);
      font-size: 18px;
      font-weight: 300;
      line-height: 1.2;
      margin-top: 12px;
    }

    .related-card p {
      color: var(--rivano-muted);
      font-family: var(--font-sans);
      font-size: 13px;
      line-height: 1.35;
      margin-top: 4px;
    }

    .desktop-sticky-bar[hidden] {
      display: none;
    }

    .mobile-sticky-copy p,
    .mobile-sticky-copy span {
      display: block;
      font-family: var(--font-sans);
      line-height: 1.25;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .mobile-sticky-copy p {
      color: var(--rivano-brown);
      font-size: 12px;
      max-width: 150px;
    }

    .mobile-sticky-copy span {
      color: color-mix(in srgb, var(--rivano-brown) 58%, transparent);
      font-size: 12px;
      margin-top: 2px;
    }

    .desktop-sticky-bar {
      display: none;
    }

    @media (min-width: 768px) {
      .pdp-main {
        display: grid;
        gap: 40px;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        margin: 0 auto;
        max-width: 1360px;
        padding: 72px 40px;
      }

      .pdp-gallery {
        grid-column: 1 / span 7;
      }

      .product-panel {
        align-self: start;
        gap: 0;
        grid-column: 8 / span 5;
        padding: 12px 0 0 24px;
        position: sticky;
        top: 32px;
      }

      /* O painel inteiro ja acompanha a rolagem no desktop; o CTA volta
         ao fluxo dentro dele. */
      .pdp-buy {
        padding: 24px 0 0;
        position: static;
      }

      .assisted-section {
        padding: 72px 40px;
      }

      .assisted-inner {
        margin: 0 auto;
        max-width: 1280px;
      }

      .assisted-grid {
        gap: 28px;
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .related-section {
        padding: 72px 40px 88px;
      }

      .related-title {
        margin: 0 auto 28px;
        max-width: 1280px;
        padding: 0;
      }

      .related-track {
        display: grid;
        gap: 24px;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        margin: 0 auto;
        max-width: 1280px;
        overflow: visible;
        padding: 0;
      }

      .related-card {
        flex: initial;
      }

      .desktop-sticky-bar {
        align-items: center;
        background: var(--rivano-off-white);
        border-bottom: 1px solid var(--rivano-beige);
        display: flex;
        height: 62px;
        justify-content: space-between;
        left: 0;
        padding: 0 40px;
        position: fixed;
        top: 0;
        width: 100%;
        z-index: 120;
      }

      .sticky-product {
        align-items: center;
        display: flex;
        gap: 12px;
      }

      .sticky-product-image {
        background: color-mix(in srgb, var(--rivano-off-white) 82%, var(--rivano-beige));
        height: 48px;
        mix-blend-mode: multiply;
        object-fit: contain;
        padding: 4px;
        width: 36px;
      }

      .sticky-product-name,
      .sticky-product-price {
        font-family: var(--font-sans);
        font-size: 13px;
        line-height: 1.2;
      }

      .sticky-product-name {
        color: var(--rivano-brown);
      }

      .sticky-product-price {
        color: color-mix(in srgb, var(--rivano-brown) 60%, transparent);
        margin-top: 3px;
      }

      .sticky-whatsapp-link {
        min-height: 44px;
      }

    }
  </style>

  <script is:inline>
    const carousel = document.querySelector("[data-carousel]");
    const dots = Array.from(document.querySelectorAll("[data-dot]"));

    if (carousel && dots.length > 0) {
      const setActiveDot = (index) => {
        dots.forEach((dot, dotIndex) => {
          const indicator = dot.querySelector("[data-dot-indicator]");
          const isActive = dotIndex === index;
          dot.setAttribute("aria-current", isActive ? "true" : "false");
          indicator?.classList.toggle("is-active", isActive);
        });
      };

      const getCarouselIndex = () => {
        const width = carousel.clientWidth || 1;
        return Math.round(carousel.scrollLeft / width);
      };

      setActiveDot(0);

      carousel.addEventListener("scroll", () => {
        setActiveDot(getCarouselIndex());
      });

      dots.forEach((dot) => {
        dot.addEventListener("click", () => {
          const index = Number(dot.getAttribute("data-dot") || 0);
          const width = carousel.clientWidth || 1;
          carousel.scrollTo({ left: width * index, behavior: "smooth" });
        });
      });
    }

    const mainImage = document.querySelector("[data-main-image]");
    const thumbnails = Array.from(document.querySelectorAll("[data-thumb]"));

    if (mainImage && thumbnails.length > 0) {
      thumbnails.forEach((thumbnail) => {
        thumbnail.addEventListener("click", () => {
          const nextSrc = thumbnail.getAttribute("data-thumb-src");
          const nextSrcset = thumbnail.getAttribute("data-thumb-srcset") || "";
          const nextAlt = thumbnail.getAttribute("data-thumb-alt") || "";

          if (!nextSrc || mainImage.getAttribute("src") === nextSrc) {
            return;
          }

          thumbnails.forEach((item) => {
            const isActive = item === thumbnail;
            item.classList.toggle("is-active", isActive);
            item.setAttribute("aria-current", isActive ? "true" : "false");
          });

          mainImage.style.opacity = "0";

          window.setTimeout(() => {
            mainImage.setAttribute("src", nextSrc);
            mainImage.setAttribute("srcset", nextSrcset);
            mainImage.setAttribute("alt", nextAlt);

            const reveal = () => {
              mainImage.style.opacity = "1";
              mainImage.removeEventListener("load", reveal);
            };

            mainImage.addEventListener("load", reveal);

            if (mainImage.complete) {
              reveal();
            }
          }, 120);
        });
      });
    }

    const variantOptions = Array.from(document.querySelectorAll("[data-variant-option]"));
    const whatsappLinks = Array.from(document.querySelectorAll("[data-whatsapp-link]"));
    const whatsappPrefix = "https://wa.me/5571993135522?text=";

    const updateWhatsappLinks = (message) => {
      if (!message) {
        return;
      }

      whatsappLinks.forEach((link) => {
        link.setAttribute("href", whatsappPrefix + encodeURIComponent(message));
      });
    };

    const activeVariant = variantOptions.find((option) => option.classList.contains("is-active"));
    updateWhatsappLinks(activeVariant?.getAttribute("data-whatsapp-message"));

    variantOptions.forEach((option) => {
      option.addEventListener("click", () => {
        if (option instanceof HTMLButtonElement && option.disabled) {
          return;
        }

        variantOptions.forEach((item) => {
          const isActive = item === option;
          item.classList.toggle("is-active", isActive);
          item.setAttribute("aria-pressed", isActive ? "true" : "false");
        });

        updateWhatsappLinks(option.getAttribute("data-whatsapp-message"));
      });
    });

    const primaryCta = document.querySelector("[data-primary-cta]");
    const stickyTargets = Array.from(document.querySelectorAll("[data-sticky-bar]"));

    if (primaryCta && stickyTargets.length > 0 && "IntersectionObserver" in window) {
      const setStickyVisibility = (show) => {
        stickyTargets.forEach((target) => {
          target.toggleAttribute("hidden", !show);
        });
      };

      setStickyVisibility(false);

      const observer = new IntersectionObserver(
        ([entry]) => {
          setStickyVisibility(!entry.isIntersecting);
        },
        { threshold: 0 },
      );

      observer.observe(primaryCta);
    }
  </script>
</BaseLayout>
