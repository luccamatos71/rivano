---
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatPriceBRL, toCardProduct, type Product } from "../lib/products";
import productsData from "../data/products.json";

const allProducts = productsData as Product[];
const editorialProducts = allProducts.slice(0, 4).map(toCardProduct);
const secondaryProducts = allProducts.slice(6, 10).map(toCardProduct);
const summerSelectionSlugs = ["rivano-saint-tropez", "rivano-tropea", "rivano-mykonos", "rivano-positano"] as const;
const summerSelectionProducts = summerSelectionSlugs.map((slug) => {
  const product = allProducts.find((item) => item.slug === slug);

  if (!product) {
    throw new Error(`Produto ${slug} não encontrado em products.json`);
  }

  return product;
});
const homePrototypePrice = 139.9;
const ibizaProduct = allProducts.find((product) => product.slug === "rivano-ibiza");

if (!ibizaProduct) {
  throw new Error("Produto Rivano Ibiza não encontrado em products.json");
}

const ibizaProductHref = `/produtos/${ibizaProduct.slug}`;
const ibizaProductName = ibizaProduct.name.replace(/^Rivano\s+/i, "");

const societyImages = Array.from({ length: 8 }, (_, index) => {
  const imageIndex = String(index + 1).padStart(2, "0");

  return {
    alt: `Rivano Society editorial ${index + 1}`,
    src: `/editorial/society/society-${imageIndex}.webp`,
  };
});
---

<BaseLayout
  title="Rivano | Óculos premium para dias de sol"
  description="Óculos premium-acessíveis da Rivano. Design autoral, verão europeu e compra pelo WhatsApp."
  showAnnouncementBar={false}
  showBottomBar={false}
>
  <div class="rivano-home">
    <section class="campaign-hero" aria-label="Campanha Rivano verão 2025">
    <img
      class="campaign-motion-fallback"
      src="/banners/hero-mobile-fallback.webp"
      alt=""
      aria-hidden="true"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
      <video
        class="campaign-image"
        data-hero-video
        autoplay
        muted
        defaultMuted
    loop
    playsinline
    webkit-playsinline="true"
    disablepictureinpicture
        preload="auto"
        poster="/banners/hero-mobile-poster.webp"
        width="720"
        height="1364"
        aria-label="Mulher usando óculos Rivano"
      >
        <source src="/banners/hero-mobile.mp4" type="video/mp4" />
      </video>
      <div class="campaign-gradient" aria-hidden="true"></div>
      <div class="campaign-content opening-entrance">
        <h1 class="campaign-title">Verão no olhar.</h1>
        <div class="campaign-actions" aria-label="Ações da campanha">
          <a class="campaign-cta" href="/catalogo">Ver modelos</a>
        </div>
      </div>
    </section>

    <section class="editorial-products opening-products" aria-labelledby="selecao-rivano">
      <div class="editorial-products-header opening-products-header">
        <p class="selection-label">Rivano eyewear</p>
        <h2 id="selecao-rivano" class="sr-only">Modelos em destaque</h2>
      </div>
      <div class="editorial-products-track opening-products-track" aria-label="Modelos em destaque">
        {
          editorialProducts.map((product, index) => (
            <a
              class="editorial-product"
              data-product={product.slug}
              href={`/produtos/${product.slug}`}
              aria-label={`Ver ${product.name}`}
            >
              <span class="editorial-product-frame">
                <img
                  class="editorial-product-image"
                  src={product.image}
                  alt={product.name}
                  loading={index === 0 ? "eager" : "lazy"}
                  decoding="async"
                />
              </span>
              <span class="editorial-product-name">{product.name.replace(/^Rivano\s+/i, "")}</span>
              <span class="editorial-product-price">{formatPriceBRL(homePrototypePrice)}</span>
            </a>
          ))
        }
      </div>
      <div class="editorial-products-link-wrap">
        <a class="editorial-text-link" href="/catalogo">Todos os modelos</a>
      </div>
    </section>

    <section class="featured-product-story" aria-label="Campanha do modelo Ibiza">
      <div class="featured-product-story-stage">
        <img
          class="featured-product-story-image"
          src="/editorial/rivano-ibiza-story-reveal.jpg"
          alt="Influenciadora Rivano usando o modelo Ibiza em uma paisagem nevada"
          width="959"
          height="1280"
          loading="lazy"
          decoding="async"
        />

        <div class="featured-product-identity" aria-label={`Modelo em destaque: ${ibizaProductName}`}>
          <h2>{ibizaProductName}</h2>
        </div>

        <div class="featured-product-commerce" aria-label={`Informações do modelo ${ibizaProductName}`}>
          <div class="featured-product-commerce-details">
            <div>
              <p class="featured-product-commerce-name">{ibizaProductName}</p>
              <p class="featured-product-commerce-price">{formatPriceBRL(homePrototypePrice)}</p>
            </div>
            <a class="featured-product-commerce-link" href={ibizaProductHref}>
              <span>Ver modelo</span>
              <svg viewBox="0 0 18 8" aria-hidden="true">
                <path d="M0 4h16M12.5.5 16 4l-3.5 3.5" fill="none" stroke="currentColor" stroke-linecap="square" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="rivano-travel-manifesto" aria-labelledby="rivano-travel-manifesto-title">
      <h2 id="rivano-travel-manifesto-title" class="sr-only">Em algum lugar sob o sol</h2>
      <p class="rivano-travel-manifesto-copy">
        <span class="rivano-travel-manifesto-line--ibiza">Ibiza at 6pm.</span>
        <span class="rivano-travel-manifesto-line--capri">Capri after <em>lunch.</em></span>
        <span class="rivano-travel-manifesto-line--boat">The last boat.</span>
        <span class="rivano-travel-manifesto-line--mykonos">Mykonos until</span>
        <em class="rivano-travel-manifesto-line--sunset">sunset.</em>
        <span class="rivano-travel-manifesto-line--dinner">Dinner at ten.</span>
        <span class="rivano-travel-manifesto-line--saint">Saint-Tropez</span>
        <span class="rivano-travel-manifesto-line--dark">after dark.</span>
        <span class="rivano-travel-manifesto-line--swim">One more <em>swim.</em></span>
        <span class="rivano-travel-manifesto-line--somewhere">Somewhere</span>
        <em class="rivano-travel-manifesto-line--under">under the sun.</em>
      </p>
    </section>

    <section class="rivano-summer-notes" aria-label="Rivano Summer Notes">
      <div class="rivano-summer-notes-stage">
        <img
          src="/editorial/rivano-summer-notes-final.webp"
          alt="Arte editorial Último barco, com óculos Rivano, laranja sanguínea e copo âmbar"
          class="rivano-summer-notes-image"
          width="1122"
          height="1402"
          loading="lazy"
          decoding="async"
        />

        <figure class="rivano-summer-notes-inset" aria-hidden="true">
          <img
            src="/editorial/rivano-summer-notes.webp"
            alt=""
            width="1122"
            height="1402"
            loading="lazy"
            decoding="async"
          />
        </figure>

      </div>
    </section>

    <section class="summer-selection" aria-labelledby="summer-selection-title">
      <header class="summer-selection-header">
        <h2 id="summer-selection-title">Seleção de verão</h2>
      </header>
      <div class="summer-selection-grid">
        {
          summerSelectionProducts.map((product) => {
            const modelName = product.name.replace(/^Rivano\s+/i, "").replaceAll("-", " ");

            return (
              <a class="summer-selection-product" href={`/produtos/${product.slug}`} aria-label={`Ver ${product.name}`}>
                <span class="summer-selection-product-stage">
                  <img
                    src={`/products/${product.slug}/editorial-grid.webp`}
                    alt={product.name}
                    loading="lazy"
                    decoding="async"
                  />
                </span>
                <span class="summer-selection-product-name">{modelName}</span>
                <span class="summer-selection-product-price">{formatPriceBRL(product.price)}</span>
              </a>
            );
          })
        }
      </div>
    </section>

    <section class="rivano-fits" aria-labelledby="rivano-fits-title">
      <div class="rivano-fits-intro">
        <p class="rivano-fits-eyebrow">Rivano Society</p>
        <h2 id="rivano-fits-title" class="rivano-fits-title"><span class="rivano-fits-phrase">Seen on you.</span> <span class="rivano-fits-phrase">Somewhere under the sun.</span></h2>
      </div>

      <div class="rivano-fits-duo">
        <figure class="rivano-fits-cell">
          <img
            class="rivano-fits-photo"
            src="/editorial/lifestyle/rivano-lifestyle-05.webp"
            alt="Óculos Rivano sob a sombra da folhagem"
            width="1080"
            height="1350"
            loading="lazy"
            decoding="async"
          />
        </figure>
        <figure class="rivano-fits-cell">
          <img
            class="rivano-fits-photo rivano-fits-photo--sea"
            src="/editorial/lifestyle/rivano-lifestyle-01.webp"
            alt="Óculos Rivano redondos em passeio de barco"
            width="1080"
            height="1350"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>

      <div class="rivano-fits-mosaic">
        <figure class="rivano-fits-cell rivano-fits-cell--dominant">
          <img
            class="rivano-fits-photo rivano-fits-photo--dominant"
            src="/editorial/lifestyle/rivano-lifestyle-02-tall.webp"
            alt="Look de verão com óculos Rivano entre palmeiras"
            width="1000"
            height="1500"
            loading="lazy"
            decoding="async"
          />
        </figure>
        <figure class="rivano-fits-cell">
          <img
            class="rivano-fits-photo"
            src="/editorial/lifestyle/rivano-lifestyle-10.webp"
            alt="Óculos Rivano brancos apoiados sobre uma bolsa"
            width="1080"
            height="1350"
            loading="lazy"
            decoding="async"
          />
        </figure>
        <figure class="rivano-fits-cell">
          <img
            class="rivano-fits-photo rivano-fits-photo--portrait"
            src="/editorial/lifestyle/rivano-lifestyle-04.webp"
            alt="Retrato com óculos Rivano de lente âmbar"
            width="1080"
            height="1350"
            loading="lazy"
            decoding="async"
          />
        </figure>
        <figure class="rivano-fits-cell rivano-fits-cell--wide-only">
          <img
            class="rivano-fits-photo"
            src="/editorial/lifestyle/rivano-lifestyle-03.webp"
            alt="Óculos Rivano brancos no fim de tarde na marina"
            width="1080"
            height="1350"
            loading="lazy"
            decoding="async"
          />
        </figure>
        <figure class="rivano-fits-cell rivano-fits-cell--wide-only">
          <img
            class="rivano-fits-photo"
            src="/editorial/lifestyle/rivano-lifestyle-06.webp"
            alt="Óculos Rivano no fim de tarde na rua"
            width="1080"
            height="1350"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>

      <div class="rivano-fits-outro">
        <h3 class="rivano-fits-outro-title">O verão tem seus lugares. Este é um deles.</h3>
        <p class="rivano-fits-outro-text">Feito para os lugares que você ainda vai conhecer e para aqueles aos quais sempre acaba voltando.</p>
        <a class="rivano-fits-outro-link" href="/catalogo">
          <svg class="rivano-fits-outro-marker" viewBox="0 0 24 24" width="12" height="16" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="m17 12-7.5 4.5v-9z" />
          </svg>
          Ver todos os modelos
        </a>
      </div>

      <figure class="rivano-break">
        <picture>
          <source media="(min-width: 768px)" srcset="/editorial/lifestyle/rivano-break-wide.webp" width="1024" height="576" />
          <img
            class="rivano-break-photo"
            src="/editorial/lifestyle/rivano-break-portrait.webp"
            alt="Óculos Rivano brancos sobre uma revista, ao lado de bolsa de palha e chapéu na areia"
            width="1024"
            height="1365"
            loading="lazy"
            decoding="async"
          />
        </picture>
      </figure>
    </section>

    <section class="brand-story-section" aria-label="O espírito Rivano">
      <div class="brand-story-inner">
        <div class="brand-story-copy" data-reveal>
          <p class="brand-story-label">O espírito Rivano</p>
          <h2 class="brand-story-title">Feita para o sol que fica.</h2>
          <p class="brand-story-text">Da cidade à beira-mar, a Rivano traduz o verão como presença: leve, elegante e impossível de apressar.</p>
          <a class="brand-story-link" href="/catalogo">Conhecer a marca</a>
        </div>
      </div>
    </section>

    <section class="latest-rays-section" aria-labelledby="ultimos-raios">
      <div class="latest-rays-header" data-reveal>
        <p class="latest-rays-label">Curadoria Rivano</p>
        <h2 id="ultimos-raios" class="display-md latest-rays-title">Últimos raios</h2>
        <p class="latest-rays-subtitle">Armações escolhidas para acompanhar a luz até o fim do dia.</p>
      </div>
      <div class="latest-rays-track" data-reveal data-reveal-delay="90">
        {
          secondaryProducts.map((product, index) => (
            <a class="latest-ray-item" href={`/produtos/${product.slug}`} aria-label={`Ver ${product.name}`}>
              <span class="latest-ray-frame">
                <img
                  class="latest-ray-image"
                  src={product.image}
                  alt={product.name}
                  loading="eager"
                  decoding="async"
                />
              </span>
              <span class="latest-ray-name">{product.name}</span>
              <span class="latest-ray-price">{formatPriceBRL(product.price)}</span>
            </a>
          ))
        }
      </div>
      <a class="latest-rays-link" href="/catalogo">Ver catálogo completo</a>
    </section>

    <section class="rivano-society-section" aria-labelledby="rivano-society-title">
      <div class="rivano-society-header" data-reveal>
        <p class="rivano-society-label">Society</p>
        <h2 id="rivano-society-title" class="display-md rivano-society-title">The Rivano Society</h2>
        <p class="rivano-society-subtitle">Um ver&atilde;o visto por quem vive a Rivano.</p>
      </div>

      <div class="rivano-society-track-mobile">
        {
          societyImages.map((image) => (
            <figure class="rivano-society-item">
              <img
                class="rivano-society-image"
                src={image.src}
                alt={image.alt}
                loading="eager"
                decoding="async"
              />
            </figure>
          ))
        }
      </div>

      <div class="rivano-society-track-desktop-wrap">
        <div class="rivano-society-track-desktop">
          {[0, 1].map((groupIndex) => (
            <div class="rivano-society-desktop-group" aria-hidden={groupIndex === 1 ? "true" : undefined}>
              {societyImages.map((image) => (
                <figure class="rivano-society-item">
                  <img
                    class="rivano-society-image"
                    src={image.src}
                    alt={image.alt}
                    loading={groupIndex === 0 ? "eager" : "lazy"}
                    decoding="async"
                  />
                </figure>
              ))}
            </div>
          ))}
        </div>
      </div>

      <div class="rivano-society-cta-wrap">
        <a class="rivano-society-cta" href="/catalogo">Ver cole&ccedil;&atilde;o</a>
      </div>
    </section>
  </div>
</BaseLayout>

<script is:inline>
  const heroVideo = document.querySelector("[data-hero-video]");
  const campaignHero = document.querySelector(".campaign-hero");
  const openingProducts = document.querySelector(".opening-products");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  const startHeroVideo = () => {
    if (!(heroVideo instanceof HTMLVideoElement)) return;

    heroVideo.muted = true;
    heroVideo.defaultMuted = true;
    heroVideo.setAttribute("muted", "");
    heroVideo.play().catch(() => undefined);
  };

  const revealHeroVideo = () => campaignHero?.classList.add("is-video-playing");

  heroVideo?.addEventListener("playing", revealHeroVideo);
  startHeroVideo();
  ["loadedmetadata", "loadeddata", "canplay", "playing"].forEach((eventName) => {
    heroVideo?.addEventListener(eventName, startHeroVideo, { once: true });
  });
  document.addEventListener("visibilitychange", () => {
    if (document.visibilityState === "visible") startHeroVideo();
  });
  if (heroVideo instanceof HTMLVideoElement && !heroVideo.paused && heroVideo.readyState >= 2) {
    revealHeroVideo();
  }

  if (openingProducts) {
    const revealProducts = () => openingProducts.classList.add("is-revealed");

    if (reducedMotion.matches || !("IntersectionObserver" in window)) {
      revealProducts();
    } else {
      const openingProductsObserver = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;
          revealProducts();
          openingProductsObserver.disconnect();
        },
        { threshold: 0.18 },
      );

      openingProductsObserver.observe(openingProducts);
    }
  }

</script>

<style>
  .rivano-home {
    background: var(--rivano-off-white);
    color: var(--rivano-brown);
    --summer-notes-inset-left: 4.2vw;
    overflow-x: clip;
  }

  .campaign-hero {
    background: #e5e8e9;
    height: 100svh;
    min-height: 640px;
    overflow: hidden;
    position: relative;
    width: 100vw;
  }

  .campaign-motion-fallback,
  .campaign-image {
    background: #e5e8e9;
    display: block;
    height: 100%;
    left: 0;
    object-fit: cover;
    object-position: center;
    position: absolute;
    top: 0;
    width: 100vw;
  }

  .campaign-motion-fallback {
    object-fit: cover;
    object-position: center;
    z-index: 0;
  }

  .campaign-image {
    opacity: 0;
    transition: opacity 180ms ease-out;
    z-index: 1;
  }

  .campaign-hero.is-video-playing .campaign-image {
    opacity: 1;
  }

  .campaign-gradient {
    background: linear-gradient(0deg, rgba(9, 12, 13, 0.72) 0%, rgba(9, 12, 13, 0.2) 36%, transparent 64%);
    bottom: 0;
    height: 52%;
    left: 0;
    pointer-events: none;
    position: absolute;
    right: 0;
    z-index: 2;
  }

  .campaign-content {
    bottom: 0;
    left: 0;
    padding: 24px 20px calc(32px + env(safe-area-inset-bottom));
    position: absolute;
    width: 100%;
    z-index: 3;
  }

  .selection-label,
  .brand-story-label {
    font-family: var(--font-sans);
    font-weight: 400;
    text-transform: uppercase;
  }

  .campaign-title {
    color: var(--rivano-off-white);
    font-family: var(--font-sans);
    font-size: clamp(46px, 12.4vw, 58px);
    font-weight: 400;
    letter-spacing: -0.065em;
    line-height: 0.88;
    margin: 0;
    max-width: 260px;
  }

  .campaign-actions {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    margin-top: 22px;
  }

  .campaign-cta {
    align-items: center;
    color: var(--rivano-off-white);
    display: inline-flex;
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 400;
    border-bottom: 1px solid color-mix(in srgb, var(--rivano-off-white) 82%, transparent);
    letter-spacing: 0.1em;
    line-height: 1.2;
    min-height: 40px;
    padding-bottom: 2px;
    text-transform: uppercase;
  }

  .featured-product-story {
    background: #dfe1e1;
    margin-top: 20px;
    position: relative;
  }

  .featured-product-story-stage {
    background: #dfe1e1;
    height: clamp(680px, 94svh, 860px);
    isolation: isolate;
    overflow: hidden;
    position: relative;
    touch-action: pan-y;
    user-select: none;
    width: 100%;
  }

  .featured-product-story-image {
    inset: 0;
    position: absolute;
  }

  .featured-product-story-image {
    display: block;
    height: 100%;
    object-fit: cover;
    object-position: 49% 46%;
    width: 100%;
  }

  .featured-product-identity {
    color: #202320;
    left: 18px;
    pointer-events: none;
    position: absolute;
    top: clamp(38px, 6svh, 54px);
    transition: opacity 180ms ease;
    z-index: 3;
  }

  .featured-product-identity h2 {
    font-family: var(--font-sans);
    font-size: clamp(44px, 13vw, 58px);
    font-weight: 400;
    letter-spacing: -0.075em;
    line-height: 0.82;
    margin: 0;
    text-transform: uppercase;
  }

  .featured-product-commerce-link:focus-visible {
    outline: 1px solid #1d211f;
    outline-offset: 4px;
  }

  .featured-product-commerce {
    align-items: stretch;
    background: #f3efe5;
    border-top: 1px solid rgba(29, 33, 31, 0.66);
    bottom: 0;
    box-sizing: border-box;
    color: #1d211f;
    display: grid;
    grid-template-columns: 1fr;
    left: 0;
    min-height: calc(70px + env(safe-area-inset-bottom));
    padding: 12px 18px calc(10px + env(safe-area-inset-bottom));
    position: absolute;
    right: 0;
    width: auto;
    z-index: 6;
  }

  .featured-product-commerce-details {
    align-items: end;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0;
  }

  .featured-product-commerce-name,
  .featured-product-commerce-price {
    font-family: var(--font-sans);
    margin: 0;
  }

  .featured-product-commerce-name {
    font-size: 16px;
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1;
    text-transform: uppercase;
  }

  .featured-product-commerce-price {
    color: rgba(29, 33, 31, 0.72);
    font-size: 10px;
    line-height: 1.3;
    margin-top: 3px;
  }

  .featured-product-commerce-link {
    align-items: center;
    border-bottom: 0;
    border-left: 1px solid rgba(29, 33, 31, 0.44);
    color: #1d211f;
    display: inline-flex;
    font-family: var(--font-sans);
    font-size: 9px;
    font-weight: 500;
    gap: 8px;
    letter-spacing: 0.09em;
    line-height: 1.2;
    align-self: end;
    margin: 0;
    min-height: 42px;
    padding: 0 0 0 20px;
    text-transform: uppercase;
  }

  .featured-product-commerce-link span {
    border-bottom: 1px solid currentColor;
    padding-bottom: 3px;
  }

  .featured-product-commerce-link svg {
    height: 8px;
    width: 18px;
  }


  .opening-products {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.16) 0, #fff 88px);
    margin-top: -42px;
    padding: 74px 0 56px;
    position: relative;
    z-index: 1;
  }

  .opening-products-header {
    margin-bottom: 14px;
    padding: 0 16px;
  }

  .selection-label {
    color: color-mix(in srgb, var(--rivano-brown) 62%, transparent);
    font-size: 9px;
    letter-spacing: 0.15em;
    line-height: 1.35;
  }

  .selection-title {
    color: var(--rivano-brown);
