  /* ── Rivano Society — clone estrutural da secao "Worn by the family"
     (fouramsterdam.com). Numeros extraidos da implementacao real:
     grid 2 colunas / gutter 16 / margens 24, heroi span 2 linhas,
     celulas 4:5, headline 24px com text-indent 50px, labels brancos
     sobre gradiente, CTA sublinhado centralizado no mobile. */
  .rivano-fits {
    background: var(--rivano-brown);
    color: var(--rivano-off-white);
    padding: 64px 0 68px;
  }

  .rivano-fits-header {
    align-items: flex-end;
    display: flex;
    justify-content: space-between;
    padding: 0 24px 28px;
  }

  /* O intervalo nasce do marcador, nao de padding na secao: o eyebrow
     fecha seu proprio bloco e so entao a headline comeca. */
  .rivano-fits-eyebrow {
    color: color-mix(in srgb, var(--rivano-off-white) 62%, transparent);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.18em;
    line-height: 1.35;
    margin: 0 0 18px;
    text-transform: uppercase;
  }

  .rivano-fits-title {
    color: var(--rivano-off-white);
    font-family: var(--font-sans);
    font-size: 24px;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.25;
    margin: 0;
    text-indent: 50px;
  }

  /* Cada frase e uma unidade tipografica: a quebra acontece ENTRE as
     frases, nunca dentro de "Somewhere under the sun.". Abaixo de
     360px a frase volta a quebrar naturalmente para nao estourar. */
  .rivano-fits-phrase {
    display: inline-block;
    white-space: nowrap;
  }

  /* Ate 389px a frase inteira nao cabe em 24px: cede 3px de escala
     para manter "Somewhere under the sun." em uma linha so, em vez de
     parti-la. Abaixo de 340px nem isso resolve e ela volta a quebrar. */
  @media (max-width: 389px) {
    .rivano-fits-title {
      font-size: 21px;
    }
  }

  @media (max-width: 339px) {
    .rivano-fits-phrase {
      white-space: normal;
    }
  }

  .rivano-fits-grid {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    padding: 0 24px;
  }

  .rivano-fits-item {
    margin: 0;
    overflow: hidden;
    position: relative;
  }

  .rivano-fits-item:not(.rivano-fits-item--hero) {
    aspect-ratio: 4 / 5;
  }

  .rivano-fits-item--hero {
    grid-row: 1 / 3;
  }

  .rivano-fits-photo {
    display: block;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
    width: 100%;
  }

  .rivano-fits-item--hero picture {
    display: block;
    height: 100%;
  }

  .rivano-fits-photo--hero {
    object-position: 50% 28%;
  }

  .rivano-fits-photo--portrait {
    object-position: 50% 80%;
  }

  .rivano-fits-label {
    background: linear-gradient(to top, rgba(0, 0, 0, 0.45) 0%, rgba(0, 0, 0, 0) 100%);
    bottom: 0;
    color: #fff;
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    left: 0;
    letter-spacing: 0.04em;
    line-height: 1.3;
    margin: 0;
    padding: 40px 12px 12px;
    position: absolute;
    right: 0;
  }

  .rivano-fits-footer {
    display: flex;
    justify-content: center;
    padding-top: 24px;
  }

