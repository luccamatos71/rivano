  /* ── Rivano Society — clone estrutural do bloco entre "Summer in the
     city" e "Jacket in denim" na pagina Paulas Ibiza da loewe.com.
     Numeros medidos na implementacao real, em 390px e em 1440px:

       intro   texto com padding lateral
       DUO     duas celulas de 50%, proporcao 3:4, sem gutter
       MOSAIC  dominante de 2 unidades + menores de 1 unidade,
               proporcao 2:3, alinhadas ao topo, sem gutter — o branco
               abaixo das menores e intencional

     A faixa vale 4 unidades no mobile (dominante + 2 menores) e 6 no
     desktop (dominante + 4 menores), como na referencia. O peso da
     secao vem da escala da fotografia, nao de massa de cor. */
  .rivano-fits {
    background: var(--rivano-off-white);
    color: var(--rivano-brown);
    padding: 64px 0 0;
  }

  .rivano-fits-intro {
    padding: 0 24px 28px;
  }

  /* Mesmo vocabulario de .brand-story-label e .latest-rays-label. */
  .rivano-fits-eyebrow {
    color: color-mix(in srgb, var(--rivano-brown) 45%, transparent);
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.16em;
    line-height: 1.35;
    margin: 0;
    text-transform: uppercase;
  }

  /* Serif do sistema, como toda headline editorial da home
     (.brand-story-title, .latest-rays-title, .rivano-society-title).
     A escala acompanha a viewport para manter cada frase inteira. */
  .rivano-fits-title {
    color: var(--rivano-brown);
    font-family: var(--font-serif);
    font-size: clamp(26px, 8vw, 40px);
    font-weight: 300;
    letter-spacing: 0;
    line-height: 1.05;
    margin: 12px 0 0;
  }

  /* Cada frase e uma unidade: a quebra cai ENTRE as frases, nunca
     dentro de "Somewhere under the sun.". */
  .rivano-fits-phrase {
    display: inline-block;
    white-space: nowrap;
  }

  @media (max-width: 339px) {
    .rivano-fits-phrase {
      white-space: normal;
    }
  }

  /* Bloco A — duas celulas de meia largura, coladas, edge-to-edge. */
  .rivano-fits-duo {
    display: grid;
    gap: 0;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .rivano-fits-duo .rivano-fits-cell {
    aspect-ratio: 3 / 4;
  }

  /* Bloco B — a dominante vale duas unidades e desce o dobro; as
     menores param no topo e deixam o branco embaixo. */
  .rivano-fits-mosaic {
    align-items: start;
    display: grid;
    gap: 0;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .rivano-fits-mosaic .rivano-fits-cell {
    aspect-ratio: 2 / 3;
  }

  .rivano-fits-cell--dominant {
    grid-column: span 2;
  }

  .rivano-fits-cell--wide-only {
    display: none;
  }

  .rivano-fits-cell {
    margin: 0;
    overflow: hidden;
    position: relative;
  }

  .rivano-fits-photo {
    display: block;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
    width: 100%;
  }

  .rivano-fits-photo--dominant {
    object-position: 50% 50%;
  }

  .rivano-fits-photo--portrait {
    object-position: 50% 38%;
  }

  .rivano-fits-photo--sea {
    object-position: 50% 40%;
  }

  /* Bloco editorial de fechamento — clone do micro-layout "Woven
     baskets" da mesma pagina de referencia. Medidas reais em 390px:
     coluna de 176px (45,8vw) alinhada a esquerda, 59px de respiro
     depois da fotografia, titulo 18/22.5, 16px ate o paragrafo
     14/19.6, 16px ate o link, 48px ate o proximo capitulo.
     A coluna estreita e o branco em volta sao o desenho: nao encher. */
  .rivano-fits-outro {
    margin: 72px 24px 0;
    max-width: 82%;
  }

  .rivano-fits-outro-title {
    color: var(--rivano-brown);
    font-family: var(--font-serif);
    font-size: 18px;
    font-weight: 300;
    letter-spacing: 0.005em;
    line-height: 1.35;
    margin: 0 0 14px;
  }

  .rivano-fits-outro-text {
    color: color-mix(in srgb, var(--rivano-brown) 70%, transparent);
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 300;
    line-height: 1.6;
    margin: 0;
  }

  /* Marcador triangular do link, como na referencia. */
  .rivano-fits-outro-link {
    align-items: center;
    color: var(--rivano-brown);
    display: inline-flex;
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 400;
    gap: 4px;
    letter-spacing: 0.12em;
    line-height: 1.2;
    margin-top: 14px;
    min-height: 44px;
    text-decoration: none;
    text-transform: uppercase;
  }

  .rivano-fits-outro-marker {
    display: block;
    flex: none;
  }

  /* Quebra fotografica — clone da transicao "texto -> fotografia
     full-width" da mesma pagina de referencia. Medidas reais:
     48px de respiro depois do texto (constante em mobile e desktop),
     largura cheia sem margem lateral no mobile, proporcao 3:4;
     em >=768px a margem de 24px do container entra e a proporcao vira
     16:9, como a referencia faz nesse mesmo bloco.
     Fotografia pura: sem texto, overlay, borda ou raio. */
  .rivano-break {
    margin: 48px 0 0;
  }

  .rivano-break picture {
    display: block;
  }

  .rivano-break-photo {
    aspect-ratio: 3 / 4;
    display: block;
    height: auto;
    object-fit: cover;
    object-position: 50% 50%;
    width: 100%;
  }

