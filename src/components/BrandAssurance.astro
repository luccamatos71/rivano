---
// Bloco 03 do PDP — serviço e confiança.
//
// Este bloco existe por dois motivos: comunicar as garantias reais da
// Rivano e QUEBRAR O RITMO da página. Os blocos 01 e 02 são brancos,
// com serif grande, régua fina e muito respiro. Repetir esse vocabulário
// aqui deixaria o PDP monótono — foi exatamente o erro da versão
// anterior deste bloco.
//
// O que muda, de propósito:
//   superfície  — marrom cheio, não branco
//   tipografia  — sans dominante, sem headline serif
//   densidade   — mais apertado que os blocos anteriores
//   estrutura   — índice numerado, não composição editorial solta
//
// Referências de comportamento (não de marca):
//   Aesop — informação utilitária sobre superfície escura com tipografia
//   em marfim quente, corpo pequeno, sem caixa alta nem ícone.
//   Matsuda/JMM — número e rótulo como dispositivo de indexação.
//
// Informação comercial global: vale para todo o catálogo, sem imagem e
// sem lógica por produto.
const servicos = [
  { n: "01", rotulo: "Frete grátis", valor: "Para todo o Brasil" },
  { n: "02", rotulo: "Trocas", valor: "30 dias", nota: "A partir do recebimento" },
  { n: "03", rotulo: "Garantia", valor: "3 meses", nota: "Contra defeitos" },
  { n: "04", rotulo: "Atendimento", valor: "Direto pelo WhatsApp" },
];
---

<section class="servico" aria-label="Serviços e garantias Rivano">
  <div class="servico-inner">
    <p class="servico-kicker">Comprar na Rivano</p>

    <ol class="servico-lista">
      {
        servicos.map((item) => (
          <li class="servico-item">
            <span class="servico-num" aria-hidden="true">{item.n}</span>
            <span class="servico-corpo">
              <span class="servico-rotulo">{item.rotulo}</span>
              <span class="servico-valor">{item.valor}</span>
              {item.nota && <span class="servico-nota">{item.nota}</span>}
            </span>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  /* Superfície cheia — a mudança de campo é o que anuncia o capítulo
     novo. Sem faixa de transição: o bloco começa e termina na cor.
     Marrom de superfície exclusivo desta seção — mais quente e com o
     dobro de croma do marrom institucional (38% contra 22%), para o
     bloco virar interrupcao cromatica de fato. NAO altera
     --rivano-brown: header, CTA e demais superficies aprovadas seguem
     intactos. Contraste com o marfim: 8,36:1. */
  .servico {
    --servico-superficie: #633c2d;
    --servico-tinta: var(--rivano-off-white);
    background: var(--servico-superficie);
    color: var(--servico-tinta);
    padding: 52px 0 56px;
  }

  .servico-inner {
    padding: 0 24px;
  }

  .servico-kicker {
    color: color-mix(in srgb, var(--servico-tinta) 64%, transparent);
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.18em;
    line-height: 1.35;
    margin: 0 0 28px;
    text-transform: uppercase;
  }

  .servico-lista {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Índice: número numa coluna estreita à esquerda, conteúdo à direita.
     A régua é clara sobre o escuro — mesma linguagem, campo invertido. */
  .servico-item {
    align-items: baseline;
    border-top: 1px solid color-mix(in srgb, var(--servico-tinta) 26%, transparent);
    display: grid;
    gap: 0 20px;
    grid-template-columns: 30px minmax(0, 1fr);
    padding: 20px 0 22px;
  }

  .servico-item:last-child {
    border-bottom: 1px solid color-mix(in srgb, var(--servico-tinta) 26%, transparent);
  }

  /* O número é dispositivo gráfico de indexação, não passo de fluxo:
     fica recuado em opacidade para não competir com a informação. */
  .servico-num {
    color: color-mix(in srgb, var(--servico-tinta) 54%, transparent);
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.06em;
    line-height: 1.4;
  }

  .servico-corpo {
    display: block;
  }

  .servico-rotulo {
    color: color-mix(in srgb, var(--servico-tinta) 72%, transparent);
    display: block;
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.16em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .servico-valor {
    color: var(--servico-tinta);
    display: block;
    font-family: var(--font-sans);
    font-size: 17px;
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.3;
    margin-top: 7px;
  }

  .servico-nota {
    color: color-mix(in srgb, var(--servico-tinta) 64%, transparent);
    display: block;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 300;
    line-height: 1.5;
    margin-top: 4px;
  }

  @media (min-width: 768px) {
    .servico {
      padding: 72px 0 76px;
    }

    .servico-inner {
      margin: 0 auto;
      max-width: 1280px;
      padding: 0 40px;
    }

    .servico-kicker {
      margin-bottom: 36px;
    }

    /* No desktop o índice vira faixa horizontal: quatro colunas com a
       mesma régua superior, lidas de uma vez. */
    .servico-lista {
      border-top: 1px solid color-mix(in srgb, var(--servico-tinta) 26%, transparent);
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .servico-item {
      border-top: 0;
      display: block;
      padding: 26px 28px 8px 0;
    }

    .servico-item:last-child {
      border-bottom: 0;
    }

    .servico-num {
      display: block;
      margin-bottom: 22px;
    }

    .servico-valor {
      font-size: 19px;
    }
  }
</style>
