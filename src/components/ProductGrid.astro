---
import ProductCard from "./ProductCard.astro";

interface ProductGridItem {
  slug: string;
  name: string;
  price: number;
  stock?: number;
  image: string;
  hoverImage?: string;
  available?: boolean;
  audience?: string[];
  faceShape?: string[];
  vibe?: string[];
}

interface Props {
  products: ProductGridItem[];
  columns?: 2 | 3;
}

const { products, columns = 2 } = Astro.props as Props;
const imageSizes = columns === 3 ? "(min-width: 1024px) 33vw, 50vw" : "(min-width: 1024px) 50vw, 50vw";
---

<div
  class:list={[
    "product-grid mx-auto grid w-full max-w-[1280px] grid-cols-2 gap-x-3 gap-y-7 px-5 sm:gap-x-6 sm:gap-y-10 sm:px-10",
    columns === 3 ? "lg:grid-cols-3" : "lg:grid-cols-2",
  ]}
>
  {
    products.map((p, i) => (
      <article
        data-product-item
        data-audience={(p.audience ?? []).join(",")}
        data-face-shape={(p.faceShape ?? []).join(",")}
        data-vibe={(p.vibe ?? []).join(",")}
      >
        <ProductCard product={p} index={i} imageSizes={imageSizes} />
      </article>
    ))
  }
</div>
